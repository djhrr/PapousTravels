<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ title or "Papou's Travels" }} — Papou's Travels</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/styles.css">
</head>
<body>
  
  <!-- Green stripe at very top -->
  <div class="site-banner" aria-hidden="true"></div>

  <!-- Large white header with logo centered between green and blue -->
  <header class="header-white" role="banner">
    <div class="header-inner">
      <img src="/assets/New-Papou-Logo.png" alt="Papou's Travels logo" class="logo">
      <h1 class="site-title">Papou's Travels</h1>
    </div>
  </header>

  <!-- Dark blue navigation under the white header -->
  <nav class="site-nav" role="navigation">
    <div class="nav-inner">
      <a href="/">Home</a>
      <a href="/blog/">Blog</a>
      <a href="#" onclick="comingSoon(event)">Trips</a>
      <a href="https://photos.app.goo.gl/ARyap15E2KuczHdk7" target="_blank" rel="noopener">Gallery</a>
      <a href="#" onclick="comingSoon(event)">Contact</a>
    </div>
  </nav>

  <div class="mission">
    <div class="inner">Leaving behind a trail of my life for those I love—travel tales, the gear that carried me, and the old familiar roads that shaped who I became.</div>
  </div>

  <main class="container" role="main">
    {{ content | safe }}
  </main>

  <div class="footer-spacer"></div>
  <div id="coming-soon-toast" style="display:none;position:fixed;bottom:32px;left:50%;transform:translateX(-50%);background:#1a3a5c;color:#fff;padding:10px 24px;border-radius:20px;font-family:Poppins,sans-serif;font-size:.95rem;box-shadow:0 4px 12px rgba(0,0,0,.2);z-index:9999">Coming soon</div>
  <script>
    function comingSoon(e) {
      e.preventDefault();
      const toast = document.getElementById('coming-soon-toast');
      toast.style.display = 'block';
      clearTimeout(toast._t);
      toast._t = setTimeout(() => toast.style.display = 'none', 2000);
    }
  </script>
</body>
</html>
