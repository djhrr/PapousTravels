---
layout: null
permalink: /admin/
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Papou Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box}
    body{font-family:Poppins,sans-serif;margin:0;background:#f4f4f4;color:#222}
    header{background:#1a3a5c;color:#fff;padding:14px 24px;display:flex;justify-content:space-between;align-items:center;gap:12px}
    header h1{margin:0;font-size:1.2rem;flex:1}
    header nav{display:flex;gap:16px}
    header a{color:#aed6f1;font-size:.85rem;text-decoration:none;cursor:pointer}
    header a:hover{color:#fff}
    .wrap{max-width:900px;margin:32px auto;padding:0 16px}
    .card{background:#fff;border-radius:8px;padding:28px;box-shadow:0 2px 8px rgba(0,0,0,.08);margin-bottom:20px}
    label{display:block;font-weight:600;margin-bottom:6px;font-size:.9rem}
    input[type=text],input[type=date],input[type=password],textarea{width:100%;padding:10px;border:1px solid #ccc;border-radius:6px;font-size:.95rem;font-family:inherit}
    textarea{min-height:120px;resize:vertical}
    .btn{display:inline-block;padding:10px 20px;border:none;border-radius:6px;cursor:pointer;font-size:.9rem;font-weight:600;font-family:inherit;transition:opacity .15s}
    .btn:disabled{opacity:.5;cursor:not-allowed}
    .btn-primary{background:#1a3a5c;color:#fff}
    .btn-secondary{background:#eee;color:#333;border:1px solid #ccc}
    .btn-danger{background:#c0392b;color:#fff}
    .btn-green{background:#27ae60;color:#fff}
    .btn-sm{padding:6px 12px;font-size:.8rem}
    .block{background:#f9f9f9;border:1px solid #ddd;border-radius:6px;padding:16px;margin-bottom:12px}
    .block-label{font-size:.75rem;font-weight:700;text-transform:uppercase;color:#888;margin-bottom:8px}
    .block-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
    .add-buttons{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
    .image-preview{max-width:100%;max-height:200px;margin-top:8px;border-radius:4px;display:none}
    .hint{font-size:.8rem;color:#888;margin-top:4px}
    .spinner{display:none;font-size:.85rem;color:#666;margin-top:8px}
    .error{color:#c0392b;font-size:.85rem;margin-top:8px}
    .field{margin-bottom:16px}
    details summary{cursor:pointer;font-size:.85rem;color:#888;margin-bottom:8px}

    /* Login */
    #login-screen{display:flex;align-items:center;justify-content:center;min-height:100vh;background:#1a3a5c}
    #login-screen .card{max-width:400px;width:100%;padding:36px}
    #login-screen h2{margin:0 0 4px;color:#1a3a5c}
    #login-screen .subtitle{color:#888;font-size:.85rem;margin-bottom:24px}

    /* Dashboard tiles */
    .dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:8px}
    .dash-tile{background:#fff;border-radius:10px;padding:32px 24px;text-align:center;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.08);border:2px solid transparent;transition:border-color .15s,transform .15s}
    .dash-tile:hover{border-color:#1a3a5c;transform:translateY(-2px)}
    .dash-tile .icon{font-size:2.4rem;margin-bottom:12px}
    .dash-tile h3{margin:0 0 6px;color:#1a3a5c;font-size:1.1rem}
    .dash-tile p{margin:0;font-size:.85rem;color:#888}
    @media(max-width:500px){.dash-grid{grid-template-columns:1fr}}

    /* Post list */
    .post-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #eee}
    .post-row:last-child{border-bottom:none}
    .post-row-info{flex:1;min-width:0}
    .post-row-info h4{margin:0 0 2px;font-size:.95rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .post-row-info span{font-size:.8rem;color:#888}
    .post-row-actions{display:flex;gap:8px;flex-shrink:0}
    .loading{text-align:center;padding:40px;color:#888}
  </style>
</head>
<body>

<!-- ── Login ─────────────────────────────────────────── -->
<div id="login-screen">
  <div class="card">
    <h2>Papou Admin</h2>
    <p class="subtitle">Sign in to manage your blog</p>
    <div class="field"><label>Username</label><input type="text" id="login-user" autofocus></div>
    <div class="field"><label>Password</label><input type="password" id="login-pass"></div>
    <details id="token-section">
      <summary>GitHub Token (required first time)</summary>
      <div class="field" style="margin-top:8px">
        <input type="password" id="login-token" placeholder="ghp_…">
        <p class="hint">Saved to your browser. Never sent anywhere except GitHub.</p>
      </div>
    </details>
    <p class="error" id="login-error" style="display:none"></p>
    <button class="btn btn-primary" style="width:100%;margin-top:8px" onclick="doLogin()">Log In</button>
  </div>
</div>

<!-- ── App Shell (shown after login) ─────────────────── -->
<div id="app" style="display:none">
  <header>
    <h1>📝 Papou's Travels — Admin</h1>
    <nav>
      <a onclick="showScreen('dashboard')">Dashboard</a>
      <a onclick="doLogout()">Log out</a>
    </nav>
  </header>

  <!-- Dashboard -->
  <div id="screen-dashboard" class="wrap" style="display:none">
    <div class="dash-grid">
      <div class="dash-tile" onclick="showScreen('new-post')">
        <div class="icon">✍️</div>
        <h3>New Post</h3>
        <p>Write and publish a new blog post</p>
      </div>
      <div class="dash-tile" onclick="loadPostList()">
        <div class="icon">📋</div>
        <h3>Edit Posts</h3>
        <p>Browse, edit, and update existing posts</p>
      </div>
    </div>
  </div>

  <!-- Post List -->
  <div id="screen-post-list" class="wrap" style="display:none">
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
        <h2 style="margin:0">All Blog Posts</h2>
        <button class="btn btn-secondary btn-sm" onclick="showScreen('dashboard')">← Back</button>
      </div>
      <div id="post-list-body"><p class="loading">Loading posts…</p></div>
    </div>
  </div>

  <!-- New Post Editor -->
  <div id="screen-new-post" class="wrap" style="display:none">
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
        <h2 style="margin:0">New Blog Post</h2>
        <button class="btn btn-secondary btn-sm" onclick="showScreen('dashboard')">← Back</button>
      </div>
      <div class="field"><label>Title</label><input type="text" id="new-title" placeholder="Enter post title…"></div>
      <div class="field"><label>Date</label><input type="date" id="new-date"></div>
      <div class="field"><label>Author</label><input type="text" id="new-author" placeholder="Papou"></div>
      <label>Content</label>
      <div id="new-blocks"></div>
      <div class="add-buttons">
        <button class="btn btn-secondary" onclick="addBlock('new','paragraph')">+ Paragraph</button>
        <button class="btn btn-secondary" onclick="addBlock('new','image')">+ Image</button>
      </div>
    </div>
    <button class="btn btn-green" id="new-publish-btn" onclick="publishNew()" style="width:100%;padding:14px;font-size:1rem">Publish Post →</button>
    <p class="spinner" id="new-spinner">⏳ Publishing…</p>
  </div>

  <!-- Edit Post -->
  <div id="screen-edit-post" class="wrap" style="display:none">
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
        <h2 style="margin:0">Edit Post</h2>
        <button class="btn btn-secondary btn-sm" onclick="loadPostList()">← Back to list</button>
      </div>
      <div class="field"><label>Title</label><input type="text" id="edit-title"></div>
      <div class="field"><label>Date</label><input type="date" id="edit-date"></div>
      <div class="field"><label>Author</label><input type="text" id="edit-author"></div>
      <label>Content <span class="hint" style="font-weight:400">(full markdown — edit freely)</span></label>
      <div class="field" style="margin-top:6px">
        <textarea id="edit-body" style="min-height:420px;font-family:monospace;font-size:.88rem"></textarea>
      </div>
    </div>
    <div style="display:flex;gap:12px">
      <button class="btn btn-green" id="edit-save-btn" onclick="saveEdit()" style="flex:1;padding:14px;font-size:1rem">Save Changes →</button>
      <button class="btn btn-danger" id="edit-delete-btn" onclick="deletePost()" style="padding:14px">Delete</button>
    </div>
    <p class="spinner" id="edit-spinner">⏳ Saving…</p>
  </div>

  <!-- Success -->
  <div id="screen-success" class="wrap" style="display:none">
    <div class="card">
      <h2 style="color:#27ae60">✅ Done!</h2>
      <p id="success-msg"></p>
      <p>GitHub Actions will rebuild the site in ~1 minute.</p>
      <p><a id="success-link" href="#" target="_blank" style="color:#1a3a5c"></a></p>
      <button class="btn btn-primary" onclick="showScreen('dashboard')" style="margin-top:12px">Back to Dashboard</button>
    </div>
  </div>
</div>

<script>
const OWNER = 'djhrr', REPO = 'papoustravels';
let ghToken = '', blockCount = 0, editingPath = '', editingSha = '';

/* ── Auth ──────────────────────────────────────────── */
function doLogin() {
  const user  = document.getElementById('login-user').value.trim();
  const pass  = document.getElementById('login-pass').value;
  const token = document.getElementById('login-token').value.trim() || localStorage.getItem('gh_token');
  if (user !== 'admin' || pass !== 'password') { showLoginErr('Invalid username or password.'); return; }
  if (!token) { showLoginErr('Please enter your GitHub token.'); document.getElementById('token-section').open = true; return; }
  localStorage.setItem('gh_token', token);
  ghToken = token;
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('app').style.display = 'block';
  showScreen('dashboard');
}
function doLogout() { ghToken = ''; document.getElementById('app').style.display='none'; document.getElementById('login-screen').style.display='flex'; }
function showLoginErr(m) { const e=document.getElementById('login-error'); e.textContent=m; e.style.display='block'; }

window.addEventListener('load', () => {
  const saved = localStorage.getItem('gh_token');
  if (saved) document.getElementById('login-token').value = saved;
  document.getElementById('login-pass').addEventListener('keydown', e => { if(e.key==='Enter') doLogin(); });
});

/* ── Screen routing ────────────────────────────────── */
function showScreen(name) {
  document.querySelectorAll('[id^=screen-]').forEach(s => s.style.display = 'none');
  document.getElementById('screen-' + name).style.display = 'block';
  if (name === 'new-post') {
    document.getElementById('new-date').value = new Date().toISOString().slice(0,10);
    document.getElementById('new-blocks').innerHTML = '';
    document.getElementById('new-title').value = '';
    document.getElementById('new-author').value = '';
    blockCount = 0;
  }
}

/* ── GitHub API ────────────────────────────────────── */
async function ghGet(path) {
  const r = await fetch(`https://api.github.com/repos/${OWNER}/${REPO}/contents/${path}`, {
    headers: { Authorization: `token ${ghToken}`, Accept: 'application/vnd.github+json' }
  });
  if (!r.ok) throw new Error(`GitHub ${r.status}`);
  return r.json();
}
async function ghPut(path, b64, message, sha) {
  const body = { message, content: b64, branch: 'main' };
  if (sha) body.sha = sha;
  const r = await fetch(`https://api.github.com/repos/${OWNER}/${REPO}/contents/${path}`, {
    method: 'PUT',
    headers: { Authorization: `token ${ghToken}`, Accept: 'application/vnd.github+json', 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  });
  if (!r.ok) throw new Error(`GitHub ${r.status}: ${await r.text()}`);
  return r.json();
}
async function ghDelete(path, sha, message) {
  const r = await fetch(`https://api.github.com/repos/${OWNER}/${REPO}/contents/${path}`, {
    method: 'DELETE',
    headers: { Authorization: `token ${ghToken}`, Accept: 'application/vnd.github+json', 'Content-Type': 'application/json' },
    body: JSON.stringify({ message, sha, branch: 'main' })
  });
  if (!r.ok) throw new Error(`GitHub ${r.status}`);
}
function strToB64(str) { return btoa(unescape(encodeURIComponent(str))); }
function b64ToStr(b64) { return decodeURIComponent(escape(atob(b64))); }
function slugify(t) { return t.toLowerCase().replace(/[^a-z0-9\s-]/g,'').trim().replace(/\s+/g,'-').slice(0,60); }

/* ── Post List ─────────────────────────────────────── */
async function loadPostList() {
  showScreen('post-list');
  document.getElementById('post-list-body').innerHTML = '<p class="loading">Loading posts…</p>';
  try {
    const files = await ghGet('src/blog');
    const posts = files
      .filter(f => f.name.endsWith('.md'))
      .sort((a,b) => b.name.localeCompare(a.name));

    let html = '';
    for (const f of posts) {
      const label = f.name.replace(/\.md$/, '');
      html += `<div class="post-row">
        <div class="post-row-info">
          <h4>${label}</h4>
        </div>
        <div class="post-row-actions">
          <button class="btn btn-primary btn-sm" onclick="loadEdit('${f.path}')">Edit</button>
        </div>
      </div>`;
    }
    document.getElementById('post-list-body').innerHTML = html || '<p>No posts found.</p>';
  } catch(e) {
    document.getElementById('post-list-body').innerHTML = `<p class="error">Error: ${e.message}</p>`;
  }
}

/* ── Edit Post ─────────────────────────────────────── */
async function loadEdit(path) {
  showScreen('edit-post');
  editingPath = path;
  document.getElementById('edit-body').value = 'Loading…';
  document.getElementById('edit-save-btn').disabled = true;

  try {
    const file = await ghGet(path);
    editingSha = file.sha;
    const raw  = b64ToStr(file.content.replace(/\n/g,''));

    // Parse frontmatter
    const fmMatch = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
    if (fmMatch) {
      const fm   = fmMatch[1];
      const body = fmMatch[2];
      document.getElementById('edit-title').value  = (fm.match(/title:\s*"?(.*?)"?\s*$/m) || [])[1] || '';
      document.getElementById('edit-date').value   = (fm.match(/date:\s*(\S+)/m) || [])[1] || '';
      document.getElementById('edit-author').value = (fm.match(/author:\s*(\S+)/m) || [])[1] || '';
      document.getElementById('edit-body').value   = body.trim();
    } else {
      document.getElementById('edit-body').value = raw;
    }
    document.getElementById('edit-save-btn').disabled = false;
  } catch(e) {
    document.getElementById('edit-body').value = 'Error loading: ' + e.message;
  }
}

async function saveEdit() {
  const title  = document.getElementById('edit-title').value.trim();
  const date   = document.getElementById('edit-date').value.trim();
  const author = document.getElementById('edit-author').value.trim();
  const body   = document.getElementById('edit-body').value;

  let fm = `---\ntitle: "${title.replace(/"/g,'\\"')}"\ndate: ${date}\n`;
  if (author) fm += `author: ${author}\n`;
  fm += `layout: post\n---\n\n`;

  const full = fm + body;
  document.getElementById('edit-save-btn').disabled = true;
  document.getElementById('edit-spinner').style.display = 'block';

  try {
    // Check if slug/filename needs to change (date or title changed)
    const oldName  = editingPath.split('/').pop().replace('.md','');
    const newSlug  = `${date}-${slugify(title)}`;
    const newPath  = `src/blog/${newSlug}.md`;

    if (newPath !== editingPath) {
      // Create new file, delete old
      await ghPut(newPath, strToB64(full), `Edit post: ${title}`, null);
      await ghDelete(editingPath, editingSha, `Remove old post: ${oldName}`);
    } else {
      await ghPut(editingPath, strToB64(full), `Edit post: ${title}`, editingSha);
    }

    document.getElementById('success-msg').textContent = `"${title}" has been updated.`;
    document.getElementById('success-link').href = `https://papoustravels.com/blog/${newSlug}/`;
    document.getElementById('success-link').textContent = `papoustravels.com/blog/${newSlug}/`;
    showScreen('success');
  } catch(e) {
    alert('Error: ' + e.message);
  } finally {
    document.getElementById('edit-save-btn').disabled = false;
    document.getElementById('edit-spinner').style.display = 'none';
  }
}

async function deletePost() {
  const title = document.getElementById('edit-title').value.trim();
  if (!confirm(`Delete "${title}"? This cannot be undone.`)) return;
  document.getElementById('edit-delete-btn').disabled = true;
  try {
    await ghDelete(editingPath, editingSha, `Delete post: ${title}`);
    document.getElementById('success-msg').textContent = `"${title}" has been deleted.`;
    document.getElementById('success-link').href = 'https://papoustravels.com/blog/';
    document.getElementById('success-link').textContent = 'View blog →';
    showScreen('success');
  } catch(e) {
    alert('Error: ' + e.message);
    document.getElementById('edit-delete-btn').disabled = false;
  }
}

/* ── New Post Blocks ───────────────────────────────── */
function addBlock(prefix, type) {
  const id = ++blockCount;
  const div = document.createElement('div');
  div.className = 'block'; div.id = `${prefix}-block-${id}`; div.dataset.type = type;
  if (type === 'paragraph') {
    div.innerHTML = `<div class="block-label">Paragraph</div>
      <textarea placeholder="Write your paragraph here…"></textarea>
      <div class="block-actions">
        <button class="btn btn-secondary btn-sm" onclick="moveBlock('${prefix}',${id},-1)">↑</button>
        <button class="btn btn-secondary btn-sm" onclick="moveBlock('${prefix}',${id},1)">↓</button>
        <button class="btn btn-danger btn-sm" onclick="removeBlock('${prefix}',${id})">Remove</button>
      </div>`;
  } else {
    div.innerHTML = `<div class="block-label">Image</div>
      <input type="file" accept="image/*" onchange="previewImg(this,${id})">
      <img class="image-preview" id="prev-${id}">
      <input type="text" placeholder="Alt text / caption (optional)" style="margin-top:8px" id="alt-${id}">
      <input type="hidden" id="imgpath-${id}">
      <div class="block-actions">
        <button class="btn btn-secondary btn-sm" onclick="moveBlock('${prefix}',${id},-1)">↑</button>
        <button class="btn btn-secondary btn-sm" onclick="moveBlock('${prefix}',${id},1)">↓</button>
        <button class="btn btn-danger btn-sm" onclick="removeBlock('${prefix}',${id})">Remove</button>
      </div>`;
  }
  document.getElementById(`${prefix}-blocks`).appendChild(div);
}

function removeBlock(p,id) { document.getElementById(`${p}-block-${id}`).remove(); }
function moveBlock(p,id,dir) {
  const el = document.getElementById(`${p}-block-${id}`);
  if (dir===-1 && el.previousElementSibling) el.parentNode.insertBefore(el, el.previousElementSibling);
  if (dir===1  && el.nextElementSibling)     el.parentNode.insertBefore(el.nextElementSibling, el);
}
function previewImg(input,id) {
  const file = input.files[0]; if(!file) return;
  const r = new FileReader();
  r.onload = e => {
    const img = document.getElementById('prev-'+id);
    img.src = e.target.result; img.style.display='block';
    img.dataset.b64 = e.target.result.split(',')[1];
    img.dataset.name = file.name.replace(/\s+/g,'_');
  };
  r.readAsDataURL(file);
}

/* ── New Post Publish ──────────────────────────────── */
async function publishNew() {
  const title  = document.getElementById('new-title').value.trim();
  const date   = document.getElementById('new-date').value;
  const author = document.getElementById('new-author').value.trim();
  if (!title) { alert('Please enter a title.'); return; }

  document.getElementById('new-publish-btn').disabled = true;
  document.getElementById('new-spinner').style.display = 'block';

  try {
    const blockEls = document.querySelectorAll('#new-blocks .block');
    const lines = [];
    for (const el of blockEls) {
      if (el.dataset.type === 'paragraph') {
        const t = el.querySelector('textarea').value.trim();
        if (t) lines.push(t + '\n');
      } else {
        const preview = el.querySelector('.image-preview');
        if (!preview.dataset.b64) continue;
        const fname = Date.now() + '-' + preview.dataset.name;
        await ghPut(`assets/blog-images/${fname}`, preview.dataset.b64, `Upload image: ${fname}`, null);
        const url = `https://raw.githubusercontent.com/${OWNER}/${REPO}/main/assets/blog-images/${fname}`;
        lines.push(`![${el.querySelector('[id^=alt-]').value || ''}](${url})\n`);
      }
    }
    const slug = `${date}-${slugify(title)}`;
    let md = `---\ntitle: "${title.replace(/"/g,'\\"')}"\ndate: ${date}\n`;
    if (author) md += `author: ${author}\n`;
    md += `layout: post\n---\n\n` + lines.join('\n');

    await ghPut(`src/blog/${slug}.md`, strToB64(md), `New post: ${title}`, null);

    document.getElementById('success-msg').textContent = `"${title}" has been published.`;
    document.getElementById('success-link').href = `https://papoustravels.com/blog/${slug}/`;
    document.getElementById('success-link').textContent = `papoustravels.com/blog/${slug}/`;
    showScreen('success');
  } catch(e) {
    alert('Error: ' + e.message);
  } finally {
    document.getElementById('new-publish-btn').disabled = false;
    document.getElementById('new-spinner').style.display = 'none';
  }
}
</script>
</body>
</html>
