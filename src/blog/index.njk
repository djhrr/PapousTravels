---
layout: base
title: Blog
permalink: /blog/
---

<section class="main-col blog-page">
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:24px">
    <h1 style="margin:0">Blog</h1>
    <div class="sort-buttons">
      <span style="font-size:.85rem;color:#888;margin-right:8px">Sort:</span>
      <button class="sort-btn" id="date-toggle" data-sort="date-desc">Oldest first</button>
      <button class="sort-btn" data-sort="alpha">A – Z</button>
    </div>
  </div>

  <div class="blog-grid" id="blog-list">
    {% for post in collections.blog %}
      {% set thumb = post.content | firstImage %}
      <article class="blog-card" data-title="{{ post.data.title | escape }}" data-date="{{ post.data.date | htmlDateString }}" data-time="{{ post.data.time | timeString or '00:00' }}">
        <a href="{{ post.url }}" class="blog-card-img-link">
          {% if thumb %}
            <img class="blog-card-img" src="{{ thumb }}" alt="{{ post.data.title | escape }}" loading="lazy">
          {% else %}
            <div class="blog-card-img-placeholder">📷</div>
          {% endif %}
        </a>
        <div class="blog-card-body">
          <div class="post-meta">
            <span class="date">{{ post.data.date | readableDate }}{% if post.data.time %} at {{ post.data.time | timeString }}{% endif %}</span>
          </div>
          <h2 class="blog-card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          <p class="blog-card-excerpt">{{ post.content | firstParagraph }}</p>
          <a href="{{ post.url }}" class="read-more">Read full post →</a>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

<aside class="sidebar">
  <div class="about-blog">
    <h4>About This Blog</h4>
    <p>Travel stories, gear reviews, and motorcycle adventures from the road. Follow along as Papou explores new places and experiences.</p>
  </div>
</aside>

<script>
  const list = document.getElementById('blog-list');
  const cards = Array.from(list.querySelectorAll('.blog-card'));
  const toggle = document.getElementById('date-toggle');
  let currentSort = 'date-desc';

  function sortCards(mode) {
    cards.sort((a, b) => {
      if (mode === 'alpha') return a.dataset.title.localeCompare(b.dataset.title);
      const da = a.dataset.date + 'T' + a.dataset.time;
      const db = b.dataset.date + 'T' + b.dataset.time;
      return mode === 'date-desc' ? db.localeCompare(da) : da.localeCompare(db);
    });
    cards.forEach(c => list.appendChild(c));
  }

  sortCards('date-desc');

  toggle.addEventListener('click', () => {
    currentSort = (currentSort === 'date-desc') ? 'date-asc' : 'date-desc';
    toggle.textContent = (currentSort === 'date-desc') ? 'Oldest first' : 'Newest first';
    toggle.classList.add('active');
    document.querySelectorAll('.sort-btn:not(#date-toggle)').forEach(b => b.classList.remove('active'));
    sortCards(currentSort);
  });

  document.querySelectorAll('.sort-btn:not(#date-toggle)').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      sortCards(btn.dataset.sort);
    });
  });
</script>
