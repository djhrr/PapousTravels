---
layout: base
title: Blog
pagination:
  data: collections.blog
  size: 10
  alias: posts
permalink: "/blog/{% if pagination.pageNumber %}page-{{ pagination.pageNumber }}/{% endif %}index.html"
---

<section class="main-col blog-page">
  <h1>{{ title }}</h1>
  
  <div class="blog-list">
    {% for post in posts %}
      <article class="blog-post-card">
        <header>
          <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          <div class="post-meta">
            <span class="author">By {{ post.data.author or "Papou" }}</span>
            <span class="date">{{ post.data.date | readableDate }}</span>
          </div>
        </header>
        
        {% if post.data.description %}
          <p class="post-excerpt">{{ post.data.description }}</p>
        {% else %}
          <p class="post-excerpt">{{ post.content | striptags | slice(0, 200) }}...</p>
        {% endif %}
        
        <footer>
          <a href="{{ post.url }}" class="read-more">Read full post →</a>
        </footer>
      </article>
    {% endfor %}
  </div>
  
  <!-- Pagination -->
  {% if pagination.pages.length > 1 %}
    <nav class="pagination">
      {% if pagination.previousPageHref %}
        <a href="{{ pagination.previousPageHref }}">← Previous</a>
      {% endif %}
      
      <span class="page-info">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
      
      {% if pagination.nextPageHref %}
        <a href="{{ pagination.nextPageHref }}">Next →</a>
      {% endif %}
    </nav>
  {% endif %}
</section>

<aside class="sidebar">
  <div class="about-blog">
    <h4>About This Blog</h4>
    <p>Travel stories, gear reviews, and motorcycle adventures from the road. Follow along as Papou explores new places and experiences.</p>
  </div>
</aside>
