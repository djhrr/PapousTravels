---
layout: base
title: Home
permalink: /
---

<section class="main-col">
  <div class="features">
    {% for post in collections.blog | limit(2) %}
      {% set img = post.content | firstImage %}
      <article class="card">
        <a href="{{ post.url }}">
          <div class="thumb" style="background-image:url('{{ img if img else "/assets/New-Papou-Logo.png" }}');background-size:cover;background-position:center"></div>
        </a>
        <div class="body">
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p class="post-date">{{ post.data.date | readableDate }}</p>
          <p>{{ post.content | firstParagraph }}</p>
          <a href="{{ post.url }}" class="read-more">Read more →</a>
        </div>
      </article>
    {% endfor %}
  </div>

  {% if youtube.length %}
  <div class="article-list" style="margin-top:26px">
    <h3 style="margin-bottom:12px">Latest from YouTube</h3>
    {% for video in youtube %}
    <a href="{{ video.url }}" target="_blank" rel="noopener" class="article-item" style="text-decoration:none;color:inherit">
      <div class="meta">
        <img src="{{ video.thumbnail }}" alt="{{ video.title }}" style="width:100px;height:auto;border-radius:6px">
      </div>
      <div>
        <h4 style="color:var(--teal)">{{ video.title }}</h4>
        {% if video.description %}<p>{{ video.description }}{% if video.description.length >= 200 %}…{% endif %}</p>{% endif %}
      </div>
    </a>
    {% endfor %}
  </div>
  {% endif %}
</section>

<aside class="sidebar">
  <div class="survey">
    <h4>July 2026 Survey</h4>
    <p>Do the stories and examples help you see how our work impacts the region?</p>
    <p style="margin-top:12px"><a class="button" href="#">Start survey →</a></p>
  </div>

  <div class="events">
    <h5 style="margin-top:18px">Upcoming Events:</h5>
    <div class="event">Copilot: Lunch 'n Learn events – Practical Skills for Smarter Workflows</div>
    <div class="event">TVA 401(k) Information Sessions: LifePath Paycheck</div>
    <div class="event">TVA x Microsoft: Build Your First App with Copilot</div>
  </div>
</aside>
