---
layout: base
title: Home
permalink: /index.html
---

<section class="main-col">
  <div class="featured-posts">
    {% for post in collections.blog | slice(0, 2) %}
      <article class="featured-card">
        <a href="{{ post.url }}" class="featured-image-link">
          <div class="featured-thumb" style="background-image:url('/assets/New-Papou-Logo.png');background-size:cover;background-position:center"></div>
        </a>
        <div class="featured-body">
          <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          <p class="post-date">{{ post.data.date | readableDate }}</p>
          <p class="featured-excerpt">{{ post.content | striptags | slice(0, 300) }}...</p>
          <a href="{{ post.url }}" class="read-more">Read full post →</a>
        </div>
      </article>
    {% endfor %}
  </div>

  <div class="article-list" style="margin-top:40px">
    <h3>More Recent Posts</h3>
    {% for post in collections.blog | slice(2, 7) %}
      <div class="article-item">
        <div class="meta">
          <a href="{{ post.url }}">
            <img src="/assets/New-Papou-Logo.png" alt="" style="width:100px;height:auto;border-radius:6px">
          </a>
        </div>
        <div>
          <h4><a href="{{ post.url }}">{{ post.data.title }}</a></h4>
          <p class="post-date">{{ post.data.date | readableDate }}</p>
          <p>{{ post.content | striptags | slice(0, 150) }}...</p>
          <a href="{{ post.url }}" class="read-more">Read more →</a>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<aside class="sidebar">
  <div class="survey">
    <h4>Explore the Blog</h4>
    <p>Discover travel stories, adventure planning tips, and gear recommendations from the road.</p>
    <p style="margin-top:12px"><a class="button" href="/blog/">View all posts →</a></p>
  </div>

  <div class="events">
    <h5 style="margin-top:18px">Featured Topics:</h5>
    <div class="event">Motorcycle Camping Adventures</div>
    <div class="event">Power Generation Facility Tours</div>
    <div class="event">Travel Tips & Gear</div>
  </div>

</aside>
